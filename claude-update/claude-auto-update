#!/usr/bin/env bash
# Update Claude Code only when nobody is using it on this machine.
# "In use" means: a headless `claude -p` run is alive, or an interactive
# `claude` process is open AND the transcripts of the project it sits in
# (derived from its cwd) changed in the last IDLE_MIN minutes.
# Interactive sessions that are merely open but idle do not block the update;
# replacing the package on disk does not disturb a process already running.
# Transcripts left behind by finished headless runs (cron polls) are ignored:
# on a box that polls every few minutes they otherwise keep the whole
# projects tree "fresh" and the update never happens.
set -u
IDLE_MIN="${CLAUDE_UPDATE_IDLE_MIN:-30}"
PROJECTS="${CLAUDE_UPDATE_PROJECTS:-$HOME/.claude/projects}"
LOG_DIR="$HOME/logs/claude-update"; mkdir -p "$LOG_DIR"
LOG="$LOG_DIR/auto.log"
say() { printf '%s %s\n' "$(date -u +%FT%TZ)" "$*" >> "$LOG"; }

# --- find the npm-global prefix this install actually lives under ----------
# 1. CLAUDE_UPDATE_PREFIX, if the operator set it.
# 2. $HOME/.npm-global, if a claude binary is there (the common case on this
#    fleet).
# 3. whatever `npm config get prefix` says, as a last resort.
detect_prefix() {
  if [ -n "${CLAUDE_UPDATE_PREFIX:-}" ]; then
    printf '%s\n' "$CLAUDE_UPDATE_PREFIX"
    return 0
  fi
  if [ -x "$HOME/.npm-global/bin/claude" ]; then
    printf '%s\n' "$HOME/.npm-global"
    return 0
  fi
  if command -v npm >/dev/null 2>&1; then
    npm config get prefix 2>/dev/null
    return 0
  fi
  return 1
}

PREFIX="$(detect_prefix)"
if [ -z "$PREFIX" ]; then
  say "skip: could not determine an npm prefix (no npm on PATH, no ~/.npm-global/bin/claude)"
  exit 0
fi

# --- a native (non-npm) install does not work with this script -------------
# The standalone/native installer (curl | bash, or the platform package) does
# not live under an npm prefix and updates itself a different way. Detect it:
# the resolved `claude` binary exists but is not inside $PREFIX.
RESOLVED_CLAUDE="$(command -v claude 2>/dev/null || true)"
if [ -n "$RESOLVED_CLAUDE" ]; then
  case "$(readlink -f "$RESOLVED_CLAUDE" 2>/dev/null || printf '%s' "$RESOLVED_CLAUDE")" in
    "$PREFIX"/*) : ;;  # npm-managed, as expected
    *)
      say "skip: claude at $RESOLVED_CLAUDE is not under npm prefix $PREFIX -- looks like a native install; this script does not apply, use the CLI's own update mechanism instead"
      exit 0
      ;;
  esac
elif [ ! -x "$PREFIX/bin/claude" ]; then
  say "skip: no claude binary found under $PREFIX or on PATH"
  exit 0
fi

if pgrep -f 'claude(\.exe)? .*(-p|--print)( |$)' >/dev/null 2>&1; then say "skip: headless run alive"; exit 0; fi
# Interactive sessions: a claude process with a controlling terminal and no
# -p/--print. Map each one's cwd to its project directory the way Claude Code
# does (every "/" becomes "-") and look only there for recent transcripts.
interactive_pids() {
  ps -eo pid=,tty=,args= 2>/dev/null | awk '
    $2 != "?" && $3 ~ /(^|\/)claude(\.exe)?$/ {
      headless = 0
      for (i = 4; i <= NF; i++) if ($i == "-p" || $i == "--print") headless = 1
      if (!headless) print $1
    }'
}
if [ -d "$PROJECTS" ]; then
  for pid in $(interactive_pids); do
    cwd="$(readlink -f "/proc/$pid/cwd" 2>/dev/null)" || continue
    [ -n "$cwd" ] || continue
    # A session started with CLAUDE_CONFIG_DIR keeps its transcripts under
    # that tree, not the shared one; read only that one variable.
    base="$(tr '\0' '\n' < "/proc/$pid/environ" 2>/dev/null | sed -n 's/^CLAUDE_CONFIG_DIR=//p' | head -n1)"
    base="${base:+$base/projects}"; base="${base:-$PROJECTS}"
    proj="$base/$(printf '%s' "$cwd" | tr '/' '-')"
    [ -d "$proj" ] || continue
    if [ -n "$(find -L "$proj" -name '*.jsonl' -mmin "-$IDLE_MIN" -print -quit 2>/dev/null)" ]; then
      say "skip: interactive session in $cwd (pid $pid) was active in the last ${IDLE_MIN} min"; exit 0
    fi
  done
fi
cur="$("$PREFIX/bin/claude" --version 2>/dev/null | awk '{print $1}')"
new="$(npm view @anthropic-ai/claude-code version 2>/dev/null)"
[ -n "$new" ] || { say "skip: could not read latest version"; exit 0; }
[ "$cur" = "$new" ] && { say "ok: already $cur"; exit 0; }
if nice -n 10 npm install -g --prefix "$PREFIX" "@anthropic-ai/claude-code@$new" >>"$LOG" 2>&1; then
  say "updated: $cur -> $("$PREFIX/bin/claude" --version 2>/dev/null | awk '{print $1}')  (roll back: npm install -g --prefix $PREFIX @anthropic-ai/claude-code@$cur)"
else
  say "FAILED: update $cur -> $new; see above"; exit 1
fi
